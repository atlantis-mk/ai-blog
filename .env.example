# Local development fallback. The deployed app uses Postgres instead.
DATABASE_URL=file:./.db

# Neon Postgres connection. Vercel's Neon integration can provide this automatically.
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Created automatically when a Vercel Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Optional search-engine ownership verification codes. Use only the content value
# supplied by each webmaster platform, not the complete HTML meta tag.
# GOOGLE_SITE_VERIFICATION=google-verification-code
# BAIDU_SITE_VERIFICATION=codeva-verification-code
# BING_SITE_VERIFICATION=bing-verification-code

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional comma-separated allowlists for the remote MCP endpoint.
# The configured application URL and Vercel deployment host are allowed automatically.
# MCP_ALLOWED_HOSTS=example.com,preview.example.com
# MCP_ALLOWED_ORIGINS=https://example.com,https://preview.example.com
